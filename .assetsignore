# Files in the repo that should NOT be served as part of the site.
# wrangler reads this from the deploy directory (gitignore-style patterns).
.github
branding
README.md
.assetsignore
# Build-time only. The generator and its tests turn manuals/*.md into the
# *-manual.html pages at the root; nothing links to them and serving a build
# script as site content is just surface.
tools
tests
.gitignore
