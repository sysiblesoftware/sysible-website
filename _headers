# Cloudflare Pages headers for the Sysible download site.

# HTML: always revalidate so a new release page is picked up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Self-hosted Sora fonts are versioned by filename — cache them hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Icons. The URLs are stamped with a hash of the file (tools/stamp_icons.py), so
# a changed icon is a changed URL and nothing stale can be served under it.
# must-revalidate all the same: browsers also request these paths WITHOUT the
# stamp -- Chrome's favicon database does, and /apple-touch-icon.png is probed
# bare by iOS -- and that unstamped request must not be answered from a cache
# that predates the current icon. That is exactly how the old "S" tile survived
# two replacements.
/favicon.svg
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/icon-512.png
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/apple-touch-icon.png
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
